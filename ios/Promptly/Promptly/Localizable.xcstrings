    "Everything you made is still here. Go Pro to keep creating without limits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما أنشأته لا يزال هنا. اشترك في Pro لتواصل الإنشاء بلا حدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বানানো সবকিছু এখানেই আছে। সীমা ছাড়া বানাতে Pro নিন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du erstellt hast, ist noch da. Hol dir Pro und erstelle ohne Limits weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que has creado sigue aquí. Pasa a Pro para seguir creando sin límites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez créé est toujours là. Passez à Pro pour continuer sans limites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बनाया सब कुछ यहीं है। बिना सीमा बनाते रहने के लिए Pro लें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang Anda buat masih ada. Naik ke Pro untuk terus berkarya tanpa batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したものはすべて残っています。Pro なら制限なく作り続けられます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले बनाएको सबै यहीँ छ। सीमाविना बनाइरहन Pro लिनुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você criou continua aqui. Assine o Pro para continuar criando sem limites."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا بنایا ہوا سب کچھ یہیں ہے۔ بغیر حد کے بناتے رہنے کے لیے Pro لیں۔"
          }
        }
      }
    },
    "Everything you made is still here. Pick up where you left off.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما أنشأته لا يزال هنا. أكمل من حيث توقفت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বানানো সবকিছুই এখানে আছে। যেখানে থেমেছিলেন, সেখান থেকেই শুরু করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du erstellt hast, ist noch da. Mach da weiter, wo du aufgehört hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you made is still here. Pick up where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que creaste sigue aquí. Retoma donde lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez créé est toujours là. Reprenez où vous vous êtes arrêté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने जो कुछ बनाया वह अब भी यहाँ है। जहाँ छोड़ा था वहीं से शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang kamu buat masih ada. Lanjutkan dari tempat kamu berhenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作ったものはすべてここに残っています。続きから再開できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले बनाएका सबै कुरा यहीँ छन्। जहाँ छोड्नुभयो, त्यहीँबाट जारी राख्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que você criou continua aqui. Retome de onde parou."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی بنائی ہر چیز یہیں موجود ہے۔ جہاں چھوڑا تھا وہیں سے شروع کریں۔"
          }
        }
      }
    },
    "Everything's unlocked. No daily limit — create as much as you want.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء مفتوح. بلا حد يومي — أنشئ بقدر ما تشاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবকিছু আনলক। দৈনিক কোনো সীমা নেই — যত খুশি বানান।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles freigeschaltet. Kein Tageslimit — erstelle so viel du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo desbloqueado. Sin límite diario: crea todo lo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est débloqué. Aucune limite quotidienne — créez autant que vous voulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ अनलॉक है। कोई दैनिक सीमा नहीं — जितना चाहें बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya terbuka. Tanpa batas harian — buat sebanyak yang Anda mau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて解放されました。1日の上限なし、好きなだけつくれます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सबै अनलक भयो। दैनिक सीमा छैन — जति चाहनुहुन्छ बनाउनुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo liberado. Sem limite diário — crie quanto quiser."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب کچھ اَن لاک ہے۔ کوئی روزانہ حد نہیں — جتنا چاہیں بنائیں۔"
          }
        }
      }
    },
