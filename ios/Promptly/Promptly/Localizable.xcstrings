        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে একটি বিনামূল্যের ভিডিওর বাইরে যান — সবকিছু, সীমাহীন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr als ein Gratis-Video pro Tag — alles, unbegrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve más allá de tu vídeo gratis al día: todo, sin límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépasse ta vidéo gratuite par jour — tout, en illimité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़ के एक मुफ़्त वीडियो से आगे बढ़ें — सब कुछ, असीमित।"
          }
        },
        "id": {
          "stringUnit": {
