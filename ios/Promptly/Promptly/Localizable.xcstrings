        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar editanmu sesuai dengan duniamu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que vos montages collent à votre univers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit deine Edits zu deiner Welt passen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの世界に合った編集にするために。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাতে আপনার এডিট মিলে যায় আপনার জগতের সাথে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ آپ کے ایڈٹس آپ کی دنیا سے میل کھائیں۔"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि तपाईंका एडिट तपाईंकै संसारसँग मिलून्।"
          }
        }
      }
