          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি-তে সংরক্ষিত ভিডিওর সংখ্যা সীমিত। Pro প্রতিটি ভিডিও সংরক্ষণ ও শেয়ার করে — সঙ্গে সীমাহীন রেন্ডার ও চ্যাট।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gratis-Tarif enthält eine begrenzte Zahl gespeicherter Videos. Pro speichert und teilt jedes Video — dazu unbegrenzt viele neue Videos und Chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito incluye un número limitado de vídeos guardados. Pro guarda y comparte todos los vídeos, además de renders y chats ilimitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut un nombre limité de vidéos enregistrées. Pro enregistre et partage chaque vidéo — plus des rendus et discussions illimités."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री में सेव किए गए वीडियो की संख्या सीमित है। Pro हर वीडियो सेव और शेयर करता है — साथ में असीमित रेंडर और चैट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket gratis mencakup jumlah video tersimpan yang terbatas. Pro menyimpan dan membagikan setiap video — plus render dan obrolan tanpa batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランで保存できる動画数には上限があります。Pro はすべての動画を保存・共有でき、レンダリングとチャットも無制限。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निःशुल्कमा सुरक्षित भिडियोको संख्या सीमित छ। Pro ले हरेक भिडियो सुरक्षित र साझा गर्छ — सँगै असीमित रेन्डर र च्याट।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito inclui um número limitado de vídeos salvos. O Pro salva e compartilha todos os vídeos — além de renders e chats ilimitados."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت پلان میں محفوظ ویڈیوز کی تعداد محدود ہے۔ Pro ہر ویڈیو محفوظ اور شیئر کرتا ہے — ساتھ لامحدود رینڈرز اور چیٹس۔"
          }
        }
      }
    },
    "Free lets you save only a few videos. Pro saves and shares every one, and lets you make as many as you want.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المجاني يحفظ عددًا قليلًا من الفيديوهات فقط. برو يحفظ ويشارك كل واحد، وبلا حدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রিতে অল্প কিছু ভিডিও সেভ হয়। Pro সব সেভ করে, শেয়ার করে, আর যত খুশি বানাতে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis kannst du nur ein paar Videos speichern. Pro speichert und teilt jedes — und du machst so viele du willst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis solo guarda unos pocos vídeos. Pro guarda y comparte todos, y te deja hacer los que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En gratuit tu ne gardes que quelques vidéos. Pro garde et partage chacune, et tu en fais autant que tu veux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त में सिर्फ़ कुछ वीडियो सेव होते हैं। Pro हर एक सेव और शेयर करता है, और जितने चाहें बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis hanya menyimpan beberapa video. Pro menyimpan dan membagikan semuanya, sebanyak yang kamu mau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料では数本しか保存できません。Proは全部保存して共有でき、好きなだけ作れます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निःशुल्कमा केही भिडियो मात्र सेभ हुन्छ। Pro ले सबै सेभ र सेयर गर्छ, जति चाहे बनाउन दिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O grátis guarda só alguns vídeos. O Pro guarda e compartilha todos, e deixa fazer quantos quiser."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت میں صرف چند ویڈیوز محفوظ ہوتی ہیں۔ Pro ہر ایک محفوظ اور شیئر کرتا ہے، جتنی چاہیں بنائیں۔"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free lets you save only a few videos. Pro saves and shares every one, and lets you make as many as you want."
          }
        }
      }
    },
    "Free processes one video at a time. Upgrade to Pro to run up to 10 in parallel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة المجانية تعالج فيديو واحدًا في المرة. اشترك في Pro لتشغيل حتى 10 بالتوازي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি একবারে একটি ভিডিও প্রসেস করে। Pro নিলে একসঙ্গে ১০টি পর্যন্ত চলবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gratis-Tarif verarbeitet ein Video gleichzeitig. Mit Pro laufen bis zu 10 parallel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito procesa un vídeo a la vez. Pasa a Pro para procesar hasta 10 en paralelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite traite une vidéo à la fois. Passez à Pro pour en traiter jusqu'à 10 en parallèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री एक बार में एक वीडियो प्रोसेस करता है। Pro लें और एक साथ 10 तक चलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket gratis memproses satu video sekaligus. Naik ke Pro untuk menjalankan hingga 10 sekaligus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランは一度に1本の処理です。Pro なら最大10本を並行処理できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निःशुल्कले एकपटक एउटा भिडियो प्रशोधन गर्छ। Pro लिनुहोस् र १० वटासम्म सँगै चलाउनुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito processa um vídeo por vez. Assine o Pro para rodar até 10 em paralelo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت پلان ایک وقت میں ایک ویڈیو پروسیس کرتا ہے۔ Pro لیں اور 10 تک ایک ساتھ چلائیں۔"
          }
        }
      }
    },
