            "value": "आपका स्टूडियो नियमित पोस्टिंग की आदत के लिए बना है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Studiomu dibangun untuk kebiasaan posting yang konsisten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのスタジオは、コンスタントな投稿習慣のために作られています。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको स्टुडियो नियमित पोस्ट गर्ने बानीका लागि बनेको छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu estúdio foi feito para um hábito de postagem consistente."
