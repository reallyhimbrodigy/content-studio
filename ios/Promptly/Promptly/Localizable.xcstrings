    "Auto-renews until cancelled. Cancel anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد تلقائيًا حتى الإلغاء. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হয়। সেটিংসে যেকোনো সময় বাতিল করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Verlängerung. Jederzeit kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente hasta que la canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique jusqu'à annulation. Annulez à tout moment dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द करने तक अपने आप नवीनीकृत होता है। सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diperpanjang otomatis sampai dibatalkan. Batalkan kapan saja di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約するまで自動更新されます。設定からいつでも解約できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द नगरेसम्म स्वतः नवीकरण हुन्छ। सेटिङमा जुनसुकै बेला रद्द गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova automaticamente até você cancelar. Cancele quando quiser nos Ajustes."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منسوخ کرنے تک خودکار تجدید ہوتی ہے۔ سیٹنگز میں کبھی بھی منسوخ کریں۔"
          }
        }
      }
    },
