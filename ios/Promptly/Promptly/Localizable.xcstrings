    "Only if you haven't cancelled. Auto-renews until cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط إذا لم تُلغِ. يتجدد تلقائياً حتى الإلغاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur, wenn du nicht gekündigt hast. Verlängert sich automatisch bis zur Kündigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if you haven't cancelled. Auto-renews until cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si no has cancelado. Se renueva automáticamente hasta que canceles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement si vous n'avez pas annulé. Renouvellement automatique jusqu'à annulation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ तभी जब आपने रद्द न किया हो। रद्द करने तक अपने-आप रिन्यू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya jika kamu belum membatalkan. Diperpanjang otomatis sampai dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルしていない場合のみ。キャンセルするまで自動更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só se você não tiver cancelado. Renova automaticamente até o cancelamento."
          }
        }
      }
    },
