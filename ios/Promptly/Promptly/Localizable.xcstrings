    "New here? Just enter your email — we'll create your account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جديد هنا؟ أدخل بريدك الإلكتروني وسننشئ حسابك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন এসেছেন? শুধু আপনার ইমেল দিন — আমরা অ্যাকাউন্ট বানিয়ে দেব।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu hier? Gib einfach deine E-Mail ein — wir legen dein Konto an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eres nuevo? Introduce tu correo y crearemos tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveau ici ? Entre ton e-mail — on crée ton compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ नए हैं? बस अपना ईमेल डालें — हम आपका खाता बना देंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baru di sini? Masukkan emailmu — kami akan membuatkan akunnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめてですか？メールアドレスを入力すればアカウントを作成します。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नयाँ हुनुहुन्छ? इमेल हाल्नुहोस् — हामी खाता बनाइदिन्छौं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É novo por aqui? Basta informar seu e-mail — criaremos sua conta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں نئے ہیں؟ بس اپنا ای میل درج کریں — ہم آپ کا اکاؤنٹ بنا دیں گے۔"
          }
        }
      }
    },
