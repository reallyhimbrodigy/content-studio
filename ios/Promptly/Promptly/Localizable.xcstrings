            "value": "%lld/%lld साथीले भिडियो बनाइसके"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنجز %lld من أصل %lld أصدقاء فيديو"
          }
        },
        "bn": {
