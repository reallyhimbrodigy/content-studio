    "Make changes to finished edits without re-uploading. Pro unlocks the re-edit flow plus unlimited renders and chats.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل التحريرات المكتملة دون إعادة الرفع. يفتح Pro إعادة التحرير إضافة إلى معالجات ومحادثات بلا حدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার আপলোড না করেই সম্পন্ন এডিট বদলান। Pro পুনঃসম্পাদনার সঙ্গে সীমাহীন রেন্ডার ও চ্যাট খুলে দেয়।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere fertige Schnitte ohne erneutes Hochladen. Pro schaltet die Neubearbeitung frei, dazu unbegrenzte Renders und Chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia montajes terminados sin volver a subirlos. Pro desbloquea la reedición, además de renders y chats ilimitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez des montages terminés sans réimporter. Pro débloque la retouche, plus des rendus et discussions illimités."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार एडिट्स में बिना दोबारा अपलोड किए बदलाव करें। Pro री-एडिट के साथ असीमित रेंडर और चैट देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah editan yang sudah jadi tanpa unggah ulang. Pro membuka edit ulang plus render dan obrolan tanpa batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードし直さずに完成した編集を変更できます。Pro では再編集に加え、レンダリングとチャットも無制限。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनः अपलोड नगरी तयार सम्पादनमा परिवर्तन गर्नुहोस्। Pro ले पुनः सम्पादनसँगै असीमित रेन्डर र च्याट खोल्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere edições finalizadas sem reenviar. O Pro libera a reedição, além de renders e chats ilimitados."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ اپ لوڈ کیے بغیر مکمل ایڈٹس میں تبدیلی کریں۔ Pro ری ایڈٹ کے ساتھ لامحدود رینڈرز اور چیٹس دیتا ہے۔"
          }
        }
      }
    },
