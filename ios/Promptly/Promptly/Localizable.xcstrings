    "%@/wk billed annually — save %@ vs weekly": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/أسبوع بفوترة سنوية — وفّر %@ مقارنةً بالأسبوعي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/সপ্তাহ, বার্ষিক বিল — সাপ্তাহিকের তুলনায় %@ সাশ্রয়"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/Wo. jährlich abgerechnet — spare %@ gegenüber wöchentlich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@/wk billed annually — save %2$@ vs weekly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/sem con facturación anual: ahorra %@ frente al plan semanal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/sem facturé annuellement — économisez %@ par rapport à l'hebdomadaire"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/हफ़्ता, सालाना बिलिंग — साप्ताहिक की तुलना में %@ बचाएँ"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/mgg ditagih tahunan — hemat %@ dibanding mingguan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/週（年額請求）— 週払いより%@お得"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/हप्ता, वार्षिक बिलिङ — साप्ताहिकभन्दा %@ बचत"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/sem cobrado anualmente — economize %@ em relação ao semanal"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/ہفتہ، سالانہ بلنگ — ہفتہ وار کے مقابلے %@ کی بچت"
          }
        }
      }
