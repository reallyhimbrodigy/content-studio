    },
    "Save it to Photos — one tap": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos में सेव करें — बस एक टैप"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos-এ সেভ করুন — মাত্র এক ট্যাপ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos میں محفوظ کریں — بس ایک ٹیپ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظه في الصور — بضغطة واحدة"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos मा सेभ गर्नुहोस् — एकै ट्यापमा"
          }
        }
      }
    },
    "Talk to Promptly like an editor. Captions, cuts, graphics — done for you.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptly से वैसे ही बात करें जैसे अपने एडिटर से। कैप्शन, कट्स, ग्राफ़िक्स — सब आपके लिए तैयार।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একজন এডিটরের মতোই Promptly-কে বলুন। ক্যাপশন, কাট, গ্রাফিক্স — সব হয়ে যাবে আপনার হয়ে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptly سے ویسے ہی بات کریں جیسے اپنے ایڈیٹر سے۔ کیپشنز، کٹس، گرافکس — سب آپ کے لیے تیار۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث مع Promptly كما تتحدث مع مونتير. ترجمات وقص وجرافيك — كل شيء جاهز لك."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो एडिटरलाई जस्तै Promptly सँग कुरा गर्नुहोस्। क्याप्सन, कट, ग्राफिक्स — सबै तपाईंका लागि तयार।"
          }
        }
      }
    },
    "Tell me the vibe you want and I'll edit it. Try one of the suggestions below — or describe it in your own words.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बस वाइब बताइए, एडिट मुझ पर छोड़ दीजिए। नीचे दिए सुझावों में से कोई आज़माएँ — या अपने शब्दों में बताएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেমন ভাইব চান বলুন, আমি এডিট করে দেব। নিচের সাজেশনগুলো থেকে একটা বেছে নিন — বা নিজের ভাষায় বলুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مجھے بتائیں کیسا وائب چاہیے، میں ایڈٹ کر دوں گا۔ نیچے دی گئی کسی تجویز کو آزمائیں — یا اپنے الفاظ میں بیان کریں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرني بالأجواء التي تريدها وسأتولى المونتاج. جرّب أحد الاقتراحات أدناه — أو صِفها بكلماتك."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई चाहिएको भाइब भन्नुहोस्, म एडिट गरिदिन्छु। तलका सुझावमध्ये एउटा प्रयास गर्नुहोस् — वा आफ्नै शब्दमा वर्णन गर्नुहोस्।"
          }
        }
      }
    },
    "Tell me the vibe…": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वाइब बताएँ…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাইবটা বলুন…"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وائب بتائیں…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرني بالأجواء…"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "भाइब बताउनुहोस्…"
          }
        }
      }
    },
    "Unlock Promptly Pro": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptly Pro अनलॉक करें"
