    "Any video works — up to 5 minutes. We'll notify you the moment it's ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي فيديو يصلح — حتى 5 دقائق. سنخبرك فور جاهزيته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো ভিডিও চলবে — ৫ মিনিট পর্যন্ত। তৈরি হওয়ামাত্র জানিয়ে দেব।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Video geht — bis zu 5 Minuten. Wir melden uns, sobald es fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale cualquier vídeo — hasta 5 minutos. Te avisamos en cuanto esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'importe quelle vidéo — jusqu'à 5 minutes. On te prévient dès que c'est prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी वीडियो चलेगा — 5 मिनट तक। तैयार होते ही हम बता देंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video apa pun bisa — hingga 5 menit. Kami beri tahu begitu selesai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな動画でもOK、最長5分まで。完成したらすぐお知らせします。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै पनि भिडियो हुन्छ — ५ मिनेटसम्म। तयार हुनेबित्तिकै हामी सूचित गर्नेछौं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer vídeo serve — até 5 minutos. Avisamos assim que ficar pronto."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی ویڈیو چلے گی — 5 منٹ تک۔ تیار ہوتے ہی ہم اطلاع دے دیں گے۔"
          }
        }
      }
    },
