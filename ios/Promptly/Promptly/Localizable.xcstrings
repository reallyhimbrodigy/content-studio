          }
        }
      }
    },
    "Tell me the vibe you want and I'll edit it. Try one of the suggestions below — or describe it in your own words.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبرني بالأجواء التي تريدها وسأتولى المونتاج. جرّب أحد الاقتراحات أدناه — أو صِفها بكلماتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কেমন ভাইব চান বলুন, আমি এডিট করে দেব। নিচের সাজেশনগুলো থেকে একটা বেছে নিন — বা নিজের ভাষায় বলুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag mir den gewünschten Vibe und ich schneide es. Probier einen Vorschlag unten — oder beschreib es in eigenen Worten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dime el estilo que quieres y lo monto. Prueba una de las sugerencias de abajo o descríbelo con tus palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-moi l'ambiance voulue et je m'occupe du montage. Essayez une suggestion ci-dessous, ou décrivez-la avec vos mots."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बस वाइब बताइए, एडिट मुझ पर छोड़ दीजिए। नीचे दिए सुझावों में से कोई आज़माएँ — या अपने शब्दों में बताएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceritakan gaya yang Anda mau dan saya editkan. Coba salah satu saran di bawah — atau jelaskan dengan kata-kata Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんな雰囲気にしたいか教えてください。編集します。下の候補から選ぶか、自由に書いてください。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई चाहिएको भाइब भन्नुहोस्, म एडिट गरिदिन्छु। तलका सुझावमध्ये एउटा प्रयास गर्नुहोस् — वा आफ्नै शब्दमा वर्णन गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me diga o clima que você quer e eu edito. Experimente uma das sugestões abaixo — ou descreva com suas palavras."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مجھے بتائیں کیسا وائب چاہیے، میں ایڈٹ کر دوں گا۔ نیچے دی گئی کسی تجویز کو آزمائیں — یا اپنے الفاظ میں بیان کریں۔"
          }
        }
      }
    },
