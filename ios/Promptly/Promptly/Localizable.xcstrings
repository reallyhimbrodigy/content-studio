    "Takes effect the next time you open Promptly.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري المفعول عند فتح Promptly في المرة القادمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের বার Promptly খুললে এটি কার্যকর হবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim nächsten Öffnen von Promptly wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplicará la próxima vez que abras Promptly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet à la prochaine ouverture de Promptly."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली बार Promptly खोलने पर लागू होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berlaku saat kamu membuka Promptly berikutnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回 Promptly を開いたときに反映されます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्को पटक Promptly खोल्दा लागू हुन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale a partir da próxima vez que você abrir o Promptly."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی بار Promptly کھولنے پر لاگو ہوگا۔"
          }
        }
      }
    },
    "Talk to Promptly like an editor. Captions, cuts, graphics — done for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث إلى Promptly كما تتحدث إلى محرر. التسميات والقصّ والرسوم — جاهزة لك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পাদকের মতো করে Promptly-কে বলুন। ক্যাপশন, কাট, গ্রাফিক্স — আপনার জন্য তৈরি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich mit Promptly wie mit einem Cutter. Untertitel, Videoschnitt, Grafiken — für dich erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con Promptly como con un montador. Subtítulos, cortes y gráficos: hechos por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parle à Promptly comme à un monteur. Sous-titres, coupes, graphismes — faits pour toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptly से एडिटर की तरह बात करें। कैप्शन, कट्स, ग्राफ़िक्स — आपके लिए तैयार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicaralah pada Promptly seperti pada editor. Teks, potongan, grafis — beres untukmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集者に話すように Promptly に伝えるだけ。字幕もカットもグラフィックも、お任せ。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सम्पादकसँग जस्तै Promptly सँग कुरा गर्नुहोस्। क्याप्सन, कट, ग्राफिक्स — तपाईंका लागि तयार।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale com o Promptly como com um editor. Legendas, cortes e gráficos — prontos para você."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Promptly سے ایڈیٹر کی طرح بات کریں۔ کیپشنز، کٹس، گرافکس — آپ کے لیے تیار۔"
          }
        }
      }
    },
