    "Videos take a few minutes. Want us to tell you when yours is ready?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفيديو يستغرق بضع دقائق. تريد أن نخبرك عندما يجهز؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও হতে কয়েক মিনিট লাগে। আপনারটা তৈরি হলে জানাব?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos dauern ein paar Minuten. Sollen wir dir sagen, wenn deins fertig ist?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vídeos tardan unos minutos. ¿Te avisamos cuando el tuyo esté listo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vidéos prennent quelques minutes. On te prévient quand la tienne est prête ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो में कुछ मिनट लगते हैं। तैयार होने पर बता दें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Video butuh beberapa menit. Mau kami kabari kalau punyamu siap?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画は数分かかります。できたらお知らせしましょうか？"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "भिडियो बन्न केही मिनेट लाग्छ। तयार भएपछि भनौं?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vídeos levam alguns minutos. Quer que a gente avise quando o seu ficar pronto?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویڈیو میں چند منٹ لگتے ہیں۔ تیار ہونے پر بتا دیں؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos take a few minutes. Want us to tell you when yours is ready?"
          }
        }
      }
    },
