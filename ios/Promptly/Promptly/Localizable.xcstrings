        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি প্ল্যানে একবারে একটি ভিডিও"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فری پر ایک وقت میں ایک ویڈیو"
          }
        },
        "ar": {
          "stringUnit": {
