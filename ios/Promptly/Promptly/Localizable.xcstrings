        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनको एक निःशुल्क भिडियोभन्दा अगाडि बढ्नुहोस् — सबै, असीमित।"
          }
        },
        "pt-BR": {
          "stringUnit": {
