    "Pro and Max save and share every video, with no export limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ Pro وMax كل فيديو ويشاركانه، بلا حد للتصدير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ও Max প্রতিটি ভিডিও সংরক্ষণ ও শেয়ার করে, এক্সপোর্ট সীমা ছাড়াই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro und Max speichern und teilen jedes Video, ohne Export-Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro y Max guardan y comparten cada vídeo, sin límite de exportaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro et Max enregistrent et partagent chaque vidéo, sans limite d'export."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro और Max हर वीडियो सेव और शेयर करते हैं, बिना एक्सपोर्ट सीमा के।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro dan Max menyimpan dan membagikan setiap video, tanpa batas ekspor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro と Max はすべての動画を書き出し制限なしで保存・共有できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro र Max ले हरेक भिडियो निर्यात सीमाविना सुरक्षित र साझा गर्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro e Max salvam e compartilham cada vídeo, sem limite de exportação."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
