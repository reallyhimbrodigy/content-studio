    "%lld days free, then %@. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld days free, then %@. Auto-renews until cancelled — cancel anytime in your Apple Account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld días gratis, luego %2$@. Se renueva automáticamente hasta que canceles — cancela cuando quieras en los ajustes de tu Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dias grátis, depois %2$@. Renova automaticamente até o cancelamento — cancele quando quiser nas configurações da sua Apple Account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld दिन मुफ़्त, फिर %2$@। रद्द करने तक अपने-आप रिन्यू होता है — अपनी Apple Account सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld أيام مجاناً، ثم %2$@. يتجدد تلقائياً حتى الإلغاء — ألغِ في أي وقت من إعدادات Apple Account."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld hari gratis, lalu %2$@. Diperpanjang otomatis sampai dibatalkan — batalkan kapan saja di pengaturan Apple Account-mu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jours gratuits, puis %2$@. Renouvellement automatique jusqu'à annulation — annulez à tout moment dans les réglages de votre Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Tage kostenlos, danach %2$@. Verlängert sich automatisch bis zur Kündigung — jederzeit in deinen Apple-Account-Einstellungen kündbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld日間無料、その後%2$@。キャンセルするまで自動更新されます。Apple Accountの設定でいつでもキャンセルできます。"
          }
        }
      }
    },
    "You'll be charged %@ today. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be charged %@ today. Auto-renews until cancelled — cancel anytime in your Apple Account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te cobrará %@ hoy. Se renueva automáticamente hasta que canceles — cancela cuando quieras en los ajustes de tu Apple Account."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será cobrado %@ hoje. Renova automaticamente até o cancelamento — cancele quando quiser nas configurações da sua Apple Account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपसे %@ लिया जाएगा। रद्द करने तक अपने-आप रिन्यू होता है — अपनी Apple Account सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم %@ منك اليوم. يتجدد تلقائياً حتى الإلغاء — ألغِ في أي وقت من إعدادات Apple Account."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan ditagih %@ hari ini. Diperpanjang otomatis sampai dibatalkan — batalkan kapan saja di pengaturan Apple Account-mu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez facturé %@ aujourd'hui. Renouvellement automatique jusqu'à annulation — annulez à tout moment dans les réglages de votre Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir werden heute %@ berechnet. Verlängert sich automatisch bis zur Kündigung — jederzeit in deinen Apple-Account-Einstellungen kündbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日%@が請求されます。キャンセルするまで自動更新されます。Apple Accountの設定でいつでもキャンセルできます。"
          }
        }
      }
    },
