            "value": "آپ کی فری سیوز ختم ہو گئیں"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت عمليات الحفظ المجانية"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्री सेभ सकियो"
          }
        }
      }
    },
    "that's %@/month, billed yearly": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यानी %@ प्रति माह, सालाना बिलिंग"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানে মাসে %@, বিল হবে বছরে একবার"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یعنی %@ فی ماہ، سالانہ بلنگ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي %@ شهريًا، بفوترة سنوية"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अर्थात् महिनाको %@, वार्षिक रूपमा बिल हुन्छ"
          }
        }
      }
    },
    "%lld of %lld friends have made a video": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld दोस्तों ने वीडियो बनाया है"
