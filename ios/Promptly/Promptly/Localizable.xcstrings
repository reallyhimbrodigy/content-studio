          "stringUnit": {
            "state": "translated",
            "value": "Pro मा अपग्रेड गर्नुहोस्"
          }
        }
      }
    },
    "Videos that edit themselves": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वीडियो जो खुद एडिट हो जाते हैं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিডিও এডিট হয় নিজে নিজেই"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ویڈیوز جو خود ایڈٹ ہو جائیں"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فيديوهات تُحرّر نفسها بنفسها"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफैँ एडिट हुने भिडियो"
          }
        }
      }
    },
    "You can upgrade to Pro whenever you're ready — nothing was charged.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी तैयार हों, Pro में अपग्रेड कर लें — कोई पैसा नहीं कटा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তুত হলেই Pro-তে আপগ্রেড করতে পারবেন — কোনো টাকা কাটা হয়নি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب تیار ہوں، Pro پر اپ گریڈ کر لیں — کوئی رقم نہیں کٹی۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الترقية إلى Pro متى كنت مستعدًا — لم يُخصم أي مبلغ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार भएपछि जहिले पनि Pro मा अपग्रेड गर्न सक्नुहुन्छ — कुनै रकम काटिएको छैन।"
          }
        }
      }
    },
    "You'll be charged %@ %@. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे %@ का भुगतान %@ लिया जाएगा। कैंसल करने तक ऑटो-रिन्यू होता रहेगा — Apple अकाउंट सेटिंग्स में कभी भी कैंसल कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কাছ থেকে %@ চার্জ হবে %@। বাতিল না করা পর্যন্ত অটো-রিনিউ হবে — Apple Account সেটিংসে গিয়ে যেকোনো সময় বাতিল করা যাবে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے %@ چارج کیا جائے گا (%@)۔ کینسل ہونے تک خودکار تجدید ہوتی رہے گی — Apple اکاؤنٹ سیٹنگز میں کبھی بھی کینسل کریں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم %@ %@. يتجدد الاشتراك تلقائيًا حتى الإلغاء — يمكنك الإلغاء في أي وقت من إعدادات حساب Apple."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई %@ चार्ज गरिनेछ (%@)। रद्द नगरेसम्म आफैँ नवीकरण हुन्छ — Apple खाताको सेटिङबाट जहिले पनि रद्द गर्न सकिन्छ।"
          }
        }
      }
    },
    "You're out of free chats for today": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज की फ़्री चैट्स खत्म हो गईं"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের ফ্রি চ্যাট শেষ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کی فری چیٹس ختم ہو گئیں"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت دردشاتك المجانية لليوم"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आजको फ्री च्याट सकियो"
          }
        }
      }
    },
    "You're out of free renders for today": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के फ़्री रेंडर खत्म हो गए"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের ফ্রি রেন্ডার শেষ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج کے فری رینڈرز ختم ہو گئے"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت عمليات الإنتاج المجانية لليوم"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आजको फ्री रेन्डर सकियो"
          }
        }
      }
    },
    "You're out of free saves": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री सेव खत्म हो गए"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফ্রি সেভ শেষ"
          }
        },
        "ur": {
          "stringUnit": {
