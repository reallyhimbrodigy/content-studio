{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"%@\" will be permanently removed. This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف \"%@\" نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" স্থায়ীভাবে মুছে যাবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wird dauerhaft gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se eliminará permanentemente. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé définitivement. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" हमेशा के लिए हट जाएगा। इसे वापस नहीं लाया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" akan dihapus permanen. Ini tidak bisa dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を完全に削除します。元に戻せません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" स्थायी रूपमा हटाइनेछ। यसलाई फिर्ता ल्याउन सकिँदैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" será removido permanentemente. Não dá para desfazer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" مستقل طور پر ہٹا دیا جائے گا۔ اسے واپس نہیں کیا جا سکتا۔"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ (%lld%% %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ (%3$lld%% %4$@)"
          }
        }
      }
    },
    "%@ — only if you don't cancel": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — فقط إذا لم تُلغِ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — nur, wenn du nicht kündigst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — only if you don't cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — solo si no cancelas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — seulement si vous n'annulez pas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — सिर्फ़ तभी जब आप रद्द न करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — hanya jika kamu tidak membatalkan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — キャンセルしない場合のみ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — só se você não cancelar"
          }
        }
      }
    },
