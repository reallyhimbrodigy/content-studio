    "Your clip is still ready — tap to retry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقطعك لا يزال جاهزًا — اضغط لإعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ক্লিপ এখনও তৈরি আছে — আবার চেষ্টা করতে ট্যাপ করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Clip ist weiterhin bereit — tippe, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clip sigue listo — toca para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clip est toujours prêt — touchez pour réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी क्लिप अभी भी तैयार है — दोबारा कोशिश के लिए टैप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipmu masih siap — ketuk untuk coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップはそのまま残っています。タップで再試行できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको क्लिप अझै तयार छ — फेरि प्रयास गर्न ट्याप गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu clipe continua pronto — toque para tentar de novo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی کلپ اب بھی تیار ہے — دوبارہ کوشش کے لیے ٹیپ کریں۔"
          }
        }
      }
    },
