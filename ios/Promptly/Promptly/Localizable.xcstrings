        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang kamu buat masih ada. Lanjutkan dari tempat kamu berhenti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez créé est toujours là. Reprenez où vous vous êtes arrêté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du erstellt hast, ist noch da. Mach da weiter, wo du aufgehört hast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作ったものはすべてここに残っています。続きから再開できます。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বানানো সবকিছুই এখানে আছে। যেখানে থেমেছিলেন, সেখান থেকেই শুরু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی بنائی ہر چیز یہیں موجود ہے۔ جہاں چھوڑا تھا وہیں سے شروع کریں۔"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले बनाएका सबै कुरा यहीँ छन्। जहाँ छोड्नुभयो, त्यहीँबाट जारी राख्नुहोस्।"
          }
        }
      }
    },
