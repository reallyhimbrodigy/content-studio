    "This image link expired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رابط الصورة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবির লিঙ্কের মেয়াদ শেষ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildlink ist abgelaufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de imagen ha caducado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien d'image a expiré"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस इमेज का लिंक एक्सपायर हो गया"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan gambar ini kedaluwarsa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像のリンクは期限切れです"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो तस्बिरको लिंकको म्याद सकियो"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link de imagem expirou"
          }
        },
        "ur": {
