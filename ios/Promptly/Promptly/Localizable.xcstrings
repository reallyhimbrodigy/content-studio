    "So your edits match your world.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So your edits match your world."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que tus ediciones encajen con tu mundo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para suas edições combinarem com o seu mundo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि आपके एडिट आपकी दुनिया से मेल खाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتناسب تعديلاتك عالمك."
