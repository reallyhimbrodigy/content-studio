        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको यन्त्रको भाषा अनुसरण गर्छ। iOS सेटिङमा परिवर्तन गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
