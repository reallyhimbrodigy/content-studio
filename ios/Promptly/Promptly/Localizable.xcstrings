    "Tap the new chat icon to start.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط أيقونة المحادثة الجديدة للبدء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে নতুন চ্যাটের আইকনে ট্যাপ করুন।"
          }
        },
        "de": {
