    "You can change this anytime in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এটি যেকোনো সময় সেটিংসে বদলাতে পারেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das jederzeit in den Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le modifier à tout moment dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे कभी भी सेटिंग्स में बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa mengubahnya kapan saja di Pengaturan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定からいつでも変更できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं यसलाई जुनसुकै बेला सेटिङमा परिवर्तन गर्न सक्नुहुन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar isso quando quiser nos Ajustes."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اسے کبھی بھی سیٹنگز میں تبدیل کر سکتے ہیں۔"
          }
        }
      }
    },
    "You can upgrade to Pro whenever you're ready — nothing was charged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الترقية إلى Pro متى شئت — لم يتم خصم أي مبلغ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেকোনো সময় Pro নিতে পারেন — কোনো চার্জ নেওয়া হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jederzeit auf Pro upgraden — es wurde nichts berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pasar a Pro cuando quieras: no se ha cobrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer à Pro quand vous voulez — rien n'a été débité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जब चाहें Pro ले सकते हैं — कोई शुल्क नहीं लिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa naik ke Pro kapan saja — tidak ada biaya yang ditagih."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも Pro にアップグレードできます。料金は発生していません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं जहिले पनि Pro लिन सक्नुहुन्छ — कुनै शुल्क लिइएको छैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode assinar o Pro quando quiser — nada foi cobrado."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جب چاہیں Pro لے سکتے ہیں — کوئی رقم وصول نہیں کی گئی۔"
          }
        }
      }
    },
