    "That code doesn't look right. Check the letters and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن الرمز غير صحيح. تحقّق من الحروف وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডটি ঠিক মনে হচ্ছে না। অক্ষরগুলো দেখে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code sieht nicht richtig aus. Prüfe die Zeichen und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no parece correcto. Revisa las letras e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code semble incorrect. Vérifiez les lettres et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड सही नहीं लग रहा। अक्षर जाँचें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode itu sepertinya keliru. Periksa hurufnya dan coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが正しくないようです。文字を確認してもう一度お試しください。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो कोड ठिक देखिँदैन। अक्षरहरू जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não parece certo. Confira as letras e tente de novo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ کوڈ درست نہیں لگتا۔ حروف دیکھ کر دوبارہ کوشش کریں۔"
          }
        }
      }
    },
    "The editor for short-form talking-head videos.": {
      "localizations": {
