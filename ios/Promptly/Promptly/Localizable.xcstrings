    "Couldn't respond. Long-press to try again.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब नहीं मिल पाया। दोबारा कोशिश के लिए लॉन्ग-प्रेस करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর দিতে পারিনি। আবার চেষ্টা করতে লং-প্রেস করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جواب نہیں دیا جا سکا۔ دوبارہ کوشش کے لیے دیر تک دبائیں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الرد. اضغط مطوّلًا للمحاولة مرة أخرى."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाफ दिन सकिएन। फेरि प्रयास गर्न लामो थिच्नुहोस्।"
          }
        }
      }
    },
    "Couldn't upload your image — check your connection and try again.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज अपलोड नहीं हो पाई — कनेक्शन चेक करके फिर से कोशिश करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটা আপলোড হয়নি — কানেকশন চেক করে আবার চেষ্টা করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر اپ لوڈ نہیں ہو سکی — انٹرنیٹ کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر رفع صورتك — تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको तस्बिर अपलोड हुन सकेन — कनेक्सन जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "Free includes %lld AI chat messages per day. Upgrade for unlimited.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Free में रोज़ %lld AI चैट मैसेज मिलते हैं। अनलिमिटेड के लिए अपग्रेड करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি প্ল্যানে দিনে %lldটি AI চ্যাট মেসেজ। আনলিমিটেড পেতে আপগ্রেড করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فری پلان میں روزانہ %lld AI چیٹ میسجز ملتے ہیں۔ لامحدود کے لیے اپ گریڈ کریں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنحك الخطة المجانية %lld من رسائل الدردشة الذكية يوميًا. قم بالترقية لرسائل غير محدودة."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Free मा दिनको %lld AI च्याट मेसेज पाइन्छ। अनलिमिटेडका लागि अपग्रेड गर्नुहोस्।"
          }
        }
      }
    },
    "Free includes %lld video renders per day. Upgrade to Pro for unlimited.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Free में रोज़ %lld वीडियो रेंडर मिलते हैं। अनलिमिटेड के लिए Pro में अपग्रेड करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি প্ল্যানে দিনে %lldটি ভিডিও রেন্ডার। আনলিমিটেড পেতে Pro-তে আপগ্রেড করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فری پلان میں روزانہ %lld ویڈیو رینڈرز ملتے ہیں۔ لامحدود کے لیے Pro پر اپ گریڈ کریں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمنحك الخطة المجانية %lld من عمليات إنتاج الفيديو يوميًا. قم بالترقية إلى Pro لإنتاج غير محدود."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Free मा दिनको %lld भिडियो रेन्डर पाइन्छ। अनलिमिटेडका लागि Pro मा अपग्रेड गर्नुहोस्।"
          }
        }
      }
    },
    "Free includes a limited number of saved videos. Pro saves and shares every video — plus unlimited renders and chats.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Free में सीमित वीडियो ही सेव होते हैं। Pro में हर वीडियो सेव और शेयर होता है — साथ ही अनलिमिटेड रेंडर और चैट।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি প্ল্যানে সীমিত সংখ্যক ভিডিও সেভ করা যায়। Pro-তে প্রতিটি ভিডিও সেভ ও শেয়ার করা যায় — সাথে আনলিমিটেড রেন্ডার আর চ্যাট।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فری پلان میں محدود تعداد میں ویڈیوز محفوظ ہوتی ہیں۔ Pro ہر ویڈیو محفوظ اور شیئر کرتا ہے — ساتھ لامحدود رینڈرز اور چیٹس بھی۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح لك الخطة المجانية عددًا محدودًا من الفيديوهات المحفوظة. مع Pro تحفظ وتشارك كل فيديو — إضافةً إلى إنتاج ودردشة بلا حدود."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Free मा सीमित सङ्ख्यामा मात्र भिडियो सेभ हुन्छन्। Pro ले हरेक भिडियो सेभ र सेयर गर्छ — साथै अनलिमिटेड रेन्डर र च्याट।"
          }
        }
      }
    },
    "Free processes one video at a time. Upgrade to Pro to run up to 10 in parallel.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Free में एक बार में एक ही वीडियो प्रोसेस होता है। Pro में अपग्रेड करें और एक साथ 10 तक चलाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রিতে একবারে একটি ভিডিও প্রসেস হয়। Pro-তে আপগ্রেড করে একসাথে ১০টি পর্যন্ত চালান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فری پلان میں ایک وقت میں ایک ہی ویڈیو پروسیس ہوتی ہے۔ Pro پر اپ گریڈ کریں اور بیک وقت 10 تک چلائیں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج الخطة المجانية فيديو واحدًا في كل مرة. قم بالترقية إلى Pro لمعالجة حتى 10 فيديوهات معًا."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Free ले एकपटकमा एउटा भिडियो मात्र प्रोसेस गर्छ। एकैसाथ १० वटासम्म चलाउन Pro मा अपग्रेड गर्नुहोस्।"
          }
        }
      }
    },
    "Go beyond your one free video a day — everything, unlimited.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन के एक फ़्री वीडियो से आगे बढ़ें — सब कुछ, अनलिमिटेड।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিনে একটা ফ্রি ভিডিওর গণ্ডি পেরিয়ে যান — সবকিছু, আনলিমিটেড।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روزانہ ایک فری ویڈیو کی حد سے آگے بڑھیں — سب کچھ، لامحدود۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز حد فيديو واحد مجاني يوميًا — كل شيء بلا حدود."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनको एउटा फ्री भिडियोभन्दा अगाडि बढ्नुहोस् — सबै कुरा, अनलिमिटेड।"
          }
        }
      }
    },
    "Invite 3 friends who make a video — get a week of Pro": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ऐसे दोस्त इनवाइट करें जो वीडियो बनाएँ — एक हफ़्ते का Pro पाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৩ জন বন্ধুকে ইনভাইট করুন — তারা ভিডিও বানালেই পাবেন এক সপ্তাহের Pro"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایسے 3 دوست مدعو کریں جو ویڈیو بنائیں — Pro کا ایک ہفتہ مفت پائیں"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادعُ 3 أصدقاء يصنعون فيديو — واحصل على أسبوع من Pro"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "भिडियो बनाउने ३ जना साथीलाई इन्भाइट गर्नुहोस् — एक हप्ता Pro पाउनुहोस्"
          }
        }
      }
    },
    "Keep this video": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो अपने पास रखें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওটি রেখে দিন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ویڈیو اپنے پاس رکھیں"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بهذا الفيديو"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो भिडियो राख्नुहोस्"
          }
        }
      }
    },
    "Love it? Get Pro free": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पसंद आया? Pro फ़्री पाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভালো লাগছে? ফ্রিতেই Pro নিন"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پسند آیا؟ Pro مفت پائیں"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعجبك؟ احصل على Pro مجانًا"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मन पर्‍यो? Pro फ्रीमा पाउनुहोस्"
          }
        }
      }
    },
    "Make changes to finished edits without re-uploading. Pro unlocks the re-edit flow plus unlimited renders and chats.": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइनल एडिट में बदलाव करें — दोबारा अपलोड किए बिना। Pro में री-एडिट फ़्लो के साथ अनलिमिटेड रेंडर और चैट भी मिलते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার আপলোড না করেই তৈরি এডিটে পরিবর্তন আনুন। Pro-তে খুলে যায় রি-এডিট ফ্লো, সাথে আনলিমিটেড রেন্ডার আর চ্যাট।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل ایڈٹس میں دوبارہ اپ لوڈ کیے بغیر تبدیلیاں کریں۔ Pro میں ری ایڈٹ فلو کے ساتھ لامحدود رینڈرز اور چیٹس بھی ملتے ہیں۔"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل على مونتاجاتك المكتملة دون إعادة الرفع. يفتح لك Pro إعادة التحرير مع إنتاج ودردشة بلا حدود."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फेरि अपलोड नगरी तयार भइसकेका एडिटमा परिवर्तन गर्नुहोस्। Pro ले री-एडिट, साथै अनलिमिटेड रेन्डर र च्याट अनलक गर्छ।"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "hi": {
          "stringUnit": {
