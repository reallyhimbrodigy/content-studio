  "strings": {
    "Raw clip in. Studio edit out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw clip in. Studio edit out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma en bruto. Edición de estudio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vídeo bruto entra. Edição de estúdio sai."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कच्ची क्लिप डालें। स्टूडियो एडिट पाएँ।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقطع خام يدخل. تعديل احترافي يخرج."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip mentah masuk. Editan studio keluar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clip brut à l'entrée. Montage studio à la sortie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rohclip rein. Studio-Schnitt raus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素材を入れる。スタジオ編集が出来上がる。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাঁচা ক্লিপ দিন। স্টুডিও এডিট পান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خام کلپ دیں۔ اسٹوڈیو ایڈٹ پائیں۔"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कच्चा क्लिप दिनुहोस्। स्टुडियो एडिट पाउनुहोस्।"
          }
        }
      }
    },
    "Captions, cuts, and B-roll — from one talking-head take.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captions, cuts, and B-roll — from one talking-head take."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtítulos, cortes y B-roll — de una sola toma frente a cámara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Legendas, cortes e B-roll — de uma única gravação falando para a câmera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैप्शन, कट्स और B-roll — एक ही टॉकिंग-हेड टेक से।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعليقات وقصّ ولقطات B-roll — من لقطة واحدة أمام الكاميرا."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Caption, potongan, dan B-roll — dari satu take talking-head."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-titres, coupes et B-roll — à partir d'une seule prise face caméra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Untertitel, Schnitte und B-roll — aus einer einzigen Talking-Head-Aufnahme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字幕、カット、B-roll。トーク動画のワンテイクから。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাপশন, কাট আর B-roll — একটাই টকিং-হেড টেক থেকে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیپشنز، کٹس اور B-roll — کیمرے کے سامنے ایک ہی ٹیک سے۔"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्याप्सन, कट र B-roll — क्यामेराअगाडि बोलेको एउटै टेकबाट।"
          }
        }
      }
    },
