          "stringUnit": {
            "state": "translated",
            "value": "কোনো চার্জ নেওয়া হয়নি — এতে আপনার দৈনিক রেন্ডার খরচ হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts berechnet — dein Tages-Render wurde nicht verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se te ha cobrado nada — esto no ha gastado tu render diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été débité — cela n'a pas utilisé votre rendu du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई शुल्क नहीं लिया गया — इसमें आपका आज का रेंडर खर्च नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada biaya yang ditagih — ini tidak memakai render harian Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金は発生していません。1日のレンダリング回数も消費されていません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै शुल्क लिइएको छैन — यसले तपाईंको दैनिक रेन्डर खर्च गरेन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi cobrado — isso não usou seu render diário."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی رقم وصول نہیں کی گئی — اس سے آپ کا روزانہ رینڈر خرچ نہیں ہوا۔"
          }
        }
      }
    },
    "You'll be charged %@ %@. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم %@ %@. يتجدد الاشتراك تلقائيًا حتى الإلغاء — يمكنك الإلغاء في أي وقت من إعدادات حساب Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কাছ থেকে %@ চার্জ হবে %@। বাতিল না করা পর্যন্ত অটো-রিনিউ হবে — Apple Account সেটিংসে গিয়ে যেকোনো সময় বাতিল করা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir werden %@ %@ berechnet. Verlängert sich automatisch bis zur Kündigung — jederzeit in den Einstellungen deines Apple-Accounts kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te cobrará %@ %@. Se renueva automáticamente hasta que la canceles: cancela cuando quieras en los ajustes de tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez débité de %@ %@. Renouvellement automatique jusqu'à annulation — annulez à tout moment dans les réglages de votre compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे %@ का भुगतान %@ लिया जाएगा। कैंसल करने तक ऑटो-रिन्यू होता रहेगा — Apple अकाउंट सेटिंग्स में कभी भी कैंसल कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan ditagih %@ %@. Diperpanjang otomatis sampai dibatalkan — batalkan kapan saja di pengaturan Akun Apple Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ が請求されます。解約するまで自動更新され、Apple アカウントの設定からいつでも解約できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई %@ चार्ज गरिनेछ (%@)। रद्द नगरेसम्म आफैँ नवीकरण हुन्छ — Apple खाताको सेटिङबाट जहिले पनि रद्द गर्न सकिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será cobrado %@ %@. Renova automaticamente até você cancelar — cancele quando quiser nos ajustes da sua Conta Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے %@ چارج کیا جائے گا (%@)۔ کینسل ہونے تک خودکار تجدید ہوتی رہے گی — Apple اکاؤنٹ سیٹنگز میں کبھی بھی کینسل کریں۔"
          }
        }
      }
    },
    "You'll be charged %@ today. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "extractionState": "manual",
