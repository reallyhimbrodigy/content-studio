    "Couldn't respond. Long-press to try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الرد. اضغط مطوّلًا للمحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তর দিতে পারিনি। আবার চেষ্টা করতে লং-প্রেস করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort möglich. Lange drücken, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo responder. Mantén pulsado para reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponse impossible. Appui long pour réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब नहीं मिल पाया। दोबारा कोशिश के लिए लॉन्ग-प्रेस करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak bisa merespons. Tekan lama untuk mencoba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答できませんでした。長押しで再試行できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाफ दिन सकिएन। फेरि प्रयास गर्न लामो थिच्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível responder. Toque e segure para tentar de novo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جواب نہیں دیا جا سکا۔ دوبارہ کوشش کے لیے دیر تک دبائیں۔"
          }
        }
      }
    },
    "Couldn't upload your image — check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر رفع صورتك — تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিটা আপলোড হয়নি — কানেকশন চেক করে আবার চেষ্টা করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bild konnte nicht hochgeladen werden — prüfe deine Verbindung und versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo subir tu imagen: revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'importer ton image — vérifie ta connexion et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इमेज अपलोड नहीं हो पाई — कनेक्शन चेक करके फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambarmu gagal dikirim — periksa koneksi dan coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をアップロードできませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको तस्बिर अपलोड हुन सकेन — कनेक्सन जाँचेर फेरि प्रयास गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar sua imagem — verifique sua conexão e tente de novo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر اپ لوڈ نہیں ہو سکی — انٹرنیٹ کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        }
      }
    },
