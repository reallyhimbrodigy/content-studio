    "Renders take a few minutes — want us to tell you the second yours is ready?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستغرق المعالجة بضع دقائق — أنخبرك فور جاهزية فيديوك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেন্ডার হতে কয়েক মিনিট লাগে — আপনারটি তৈরি হওয়ামাত্র জানাব?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rendern dauert ein paar Minuten — sollen wir dir sofort Bescheid geben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El procesado tarda unos minutos: ¿te avisamos en cuanto esté listo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rendu prend quelques minutes — voulez-vous être prévenu dès que c'est prêt ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेंडर होने में कुछ मिनट लगते हैं — तैयार होते ही बता दें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Render butuh beberapa menit — mau kami beri tahu begitu selesai?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しには数分かかります。完成したらすぐお知らせしますか？"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रेन्डर हुन केही मिनेट लाग्छ — तयार हुनेबित्तिकै भनौं?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A renderização leva alguns minutos — quer que a gente avise assim que ficar pronta?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رینڈر ہونے میں چند منٹ لگتے ہیں — تیار ہوتے ہی بتا دیں؟"
          }
        }
      }
    },
