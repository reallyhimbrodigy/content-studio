        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que deixaria melhor? (opcional)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے کیا چیز بہتر بنائے گی؟ (اختیاری)"
          }
        }
      }
    },
    "What's on your mind? Bugs, ideas, anything — it comes straight to us.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يدور في بالك؟ أخطاء، أفكار، أي شيء — يصلنا مباشرةً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ভাবছেন? বাগ, আইডিয়া, যেকোনো কিছু — সরাসরি আমাদের কাছে আসে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was beschäftigt dich? Fehler, Ideen, alles — kommt direkt bei uns an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué se te ocurre? Fallos, ideas, lo que sea — nos llega directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'avez-vous en tête ? Bugs, idées, n'importe quoi — ça nous arrive directement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मन में क्या है? बग, आइडिया, कुछ भी — सीधे हम तक पहुँचता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang Anda pikirkan? Bug, ide, apa saja — langsung sampai ke kami."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気になっていることは？不具合、アイデア、何でも、そのまま私たちに届きます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "के सोच्दै हुनुहुन्छ? बग, आइडिया, जे पनि — सिधै हामीकहाँ आउँछ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você tem em mente? Bugs, ideias, qualquer coisa — chega direto pra gente."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے ذہن میں کیا ہے؟ بگز، آئیڈیاز، کچھ بھی — سیدھا ہم تک پہنچتا ہے۔"
          }
        }
      }
    },
