    "Welcome back — your plan has an offer waiting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أهلًا بعودتك — هناك عرض في انتظار خطتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার স্বাগতম — আপনার প্ল্যানে একটি অফার অপেক্ষা করছে"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück — für deinen Tarif wartet ein Angebot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenido de nuevo: tu plan tiene una oferta esperando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour — une offre vous attend sur votre formule"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापसी पर स्वागत है — आपके प्लान पर एक ऑफ़र इंतज़ार कर रहा है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang kembali — ada penawaran untuk paket Anda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おかえりなさい — あなたのプランにオファーがあります"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फेरि स्वागत छ — तपाईंको योजनामा एउटा अफर पर्खिरहेको छ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo de volta — seu plano tem uma oferta esperando"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خوش آمدید — آپ کے پلان پر ایک پیشکش موجود ہے"
          }
        }
      }
    },
    "What do you create?": {
      "extractionState": "manual",
      "localizations": {
