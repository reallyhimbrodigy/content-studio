        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اسٹوڈیو باقاعدہ پوسٹنگ کی عادت کے لیے بنایا گیا ہے۔"
          }
        }
      }
    },
    "Your studio is built like it's your job — because it will be.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استوديوك مبني كأنه عملك — لأنه سيكون كذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার স্টুডিও সাজানো হয়েছে পেশার মতো করেই — কারণ এটাই হতে চলেছে আপনার পেশা।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Studio ist gebaut, als wäre es dein Job — denn das wird es sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your studio is built like it's your job — because it will be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu estudio está hecho como si fuera tu trabajo — porque lo será."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre studio est conçu comme si c'était votre métier — parce que ça le deviendra."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्टूडियो ऐसे बना है जैसे यह आपका काम हो — क्योंकि यह होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Studiomu dibangun seolah ini pekerjaanmu — karena memang akan jadi begitu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのスタジオは、本業として作られています。いずれそうなるからです。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको स्टुडियो पेशाकै स्तरमा बनेको छ — किनभने चाँडै यो तपाईंको पेशा हुनेछ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu estúdio foi feito como se fosse seu trabalho — porque vai ser."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اسٹوڈیو ایسے بنا ہے جیسے یہ آپ کا کام ہو — کیونکہ جلد یہی ہوگا۔"
          }
        }
      }
    },
    "Your studio is built to get you to 1,000 followers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استوديوك مبني ليوصلك إلى 1,000 متابع."
