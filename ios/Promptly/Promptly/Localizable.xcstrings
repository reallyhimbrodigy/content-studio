    "Free includes %lld AI chat messages per day. Upgrade for unlimited.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن الخطة المجانية %lld رسائل محادثة ذكاء اصطناعي يوميًا. رقِّ للحصول على عدد غير محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি-তে দিনে %lldটি AI চ্যাট বার্তা আছে। সীমাহীনের জন্য আপগ্রেড করুন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gratis-Tarif enthält %lld KI-Chatnachrichten pro Tag. Upgrade für unbegrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito incluye %lld mensajes de chat de IA al día. Mejora para tenerlos sin límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite inclut %lld messages de discussion IA par jour. Passez à l'illimité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री में रोज़ %lld AI चैट संदेश शामिल हैं। असीमित के लिए अपग्रेड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket gratis mencakup %lld pesan obrolan AI per hari. Tingkatkan untuk tanpa batas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料プランは1日%lld件のAIチャットです。アップグレードで無制限。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निःशुल्कमा दैनिक %lld AI च्याट सन्देश छन्। असीमितका लागि अपग्रेड गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito inclui %lld mensagens de chat de IA por dia. Faça upgrade para ilimitado."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفت پلان میں روزانہ %lld AI چیٹ پیغامات شامل ہیں۔ لامحدود کے لیے اپ گریڈ کریں۔"
          }
        }
      }
    },
    "Free includes %lld video renders per day. Upgrade to Pro for unlimited.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن الخطة المجانية %lld معالجات فيديو يوميًا. اشترك في Pro للحصول على عدد غير محدود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্রি-তে দিনে %lldটি ভিডিও রেন্ডার আছে। সীমাহীনের জন্য Pro নিন।"
          }
        },
        "de": {
