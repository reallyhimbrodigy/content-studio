    "Edits take a few minutes. We'll tell you the moment your next one is done — no need to keep the app open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستغرق التحرير بضع دقائق. سنخبرك فور اكتمال التالي — لا داعي لإبقاء التطبيق مفتوحًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এডিট হতে কয়েক মিনিট লাগে। পরেরটি শেষ হওয়ামাত্র জানিয়ে দেব — অ্যাপ খুলে রাখার দরকার নেই।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnitte dauern ein paar Minuten. Wir geben dir sofort Bescheid, wenn dein nächster fertig ist — die App muss nicht offen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los montajes tardan unos minutos. Te avisamos en cuanto esté listo el siguiente: no hace falta dejar la app abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un montage prend quelques minutes. On vous prévient dès que le prochain est prêt — pas besoin de laisser l'app ouverte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एडिट होने में कुछ मिनट लगते हैं। आपकी अगली तैयार होते ही हम बता देंगे — ऐप खुला रखने की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editan butuh beberapa menit. Kami beri tahu begitu yang berikutnya selesai — tak perlu membuka aplikasi terus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集には数分かかります。次が完成したらすぐお知らせするので、アプリを開いたままにする必要はありません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सम्पादन हुन केही मिनेट लाग्छ। तपाईंको अर्को तयार हुनेबित्तिकै हामी भन्नेछौं — एप खुला राख्नुपर्दैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições levam alguns minutos. A gente avisa assim que a próxima ficar pronta — não precisa deixar o app aberto."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایڈٹ ہونے میں چند منٹ لگتے ہیں۔ آپ کی اگلی تیار ہوتے ہی ہم بتا دیں گے — ایپ کھلی رکھنے کی ضرورت نہیں۔"
          }
        }
      }
    },
