            "value": "%lld/%lld বন্ধু ভিডিও বানিয়েছে"
          }
        }
      }
    },
    "Your upload didn't finish": {
      "localizations": {
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका अपलोड पूरा नहीं हुआ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی اپ لوڈ مکمل نہیں ہوئی"
