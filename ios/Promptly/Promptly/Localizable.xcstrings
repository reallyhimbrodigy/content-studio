          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरु गर्न नयाँ च्याट आइकनमा ट्याप गर्नुहोस्।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ícone de novo chat para começar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
