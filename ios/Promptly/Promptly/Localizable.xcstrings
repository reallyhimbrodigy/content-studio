    "You weren't charged — this didn't use your daily render.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم خصم أي مبلغ — ولم تُستخدم معالجتك اليومية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো চার্জ নেওয়া হয়নি — এতে আপনার দৈনিক রেন্ডার খরচ হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts berechnet — dein Gratis-Video für heute bleibt dir erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se te ha cobrado nada — esto no ha gastado tu render diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été débité — cela n'a pas utilisé ton rendu du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई शुल्क नहीं लिया गया — इसमें आपका आज का रेंडर खर्च नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada biaya yang ditagih — ini tidak memakai render harianmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金は発生していません。1日のレンダリング回数も消費されていません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुनै शुल्क लिइएको छैन — यसले तपाईंको दैनिक रेन्डर खर्च गरेन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi cobrado — isso não usou seu render diário."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی رقم وصول نہیں کی گئی — اس سے آپ کا روزانہ رینڈر خرچ نہیں ہوا۔"
          }
        }
      }
    },
    "You weren't charged. This didn't use today's free video.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحسب عليك. لم يُستخدم فيديو اليوم المجاني."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কিছু কাটা হয়নি। আজকের ফ্রি ভিডিওটি ব্যবহার হয়নি।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir wurde nichts abgezogen. Dein Gratis-Video für heute ist noch da."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te cobramos. No se usó el vídeo gratis de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne t'a rien pris. Ta vidéo gratuite du jour est toujours là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे कुछ नहीं लिया गया। आज का मुफ़्त वीडियो इस्तेमाल नहीं हुआ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tidak ditagih. Video gratis hari ini belum terpakai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "料金はかかっていません。今日の無料の1本も減っていません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंबाट केही लिइएको छैन। आजको निःशुल्क भिडियो प्रयोग भएको छैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não foi cobrado. Não usou o vídeo grátis de hoje."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے کچھ نہیں لیا گیا۔ آج کی مفت ویڈیو استعمال نہیں ہوئی۔"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You weren't charged. This didn't use today's free video."
          }
        }
      }
    },
    "You'll be charged %@ %@. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم %@ %@. يتجدد الاشتراك تلقائيًا حتى الإلغاء — يمكنك الإلغاء في أي وقت من إعدادات حساب Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কাছ থেকে %@ চার্জ হবে %@। বাতিল না করা পর্যন্ত অটো-রিনিউ হবে — Apple Account সেটিংসে গিয়ে যেকোনো সময় বাতিল করা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir werden %@ %@ berechnet. Verlängert sich automatisch bis zur Kündigung — jederzeit in den Einstellungen deines Apple-Accounts kündbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te cobrará %@ %@. Se renueva automáticamente hasta que la canceles: cancela cuando quieras en los ajustes de tu cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras débité de %@ %@. Renouvellement automatique jusqu'à annulation — annule à tout moment dans les réglages de ton compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे %@ का भुगतान %@ लिया जाएगा। कैंसल करने तक ऑटो-रिन्यू होता रहेगा — Apple अकाउंट सेटिंग्स में कभी भी कैंसल कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda akan ditagih %@ %@. Diperpanjang otomatis sampai dibatalkan — batalkan kapan saja di pengaturan Akun Apple Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ が請求されます。解約するまで自動更新され、Apple アカウントの設定からいつでも解約できます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई %@ चार्ज गरिनेछ (%@)। रद्द नगरेसम्म आफैँ नवीकरण हुन्छ — Apple खाताको सेटिङबाट जहिले पनि रद्द गर्न सकिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será cobrado %@ %@. Renova automaticamente até você cancelar — cancele quando quiser nos ajustes da sua Conta Apple."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سے %@ چارج کیا جائے گا (%@)۔ کینسل ہونے تک خودکار تجدید ہوتی رہے گی — Apple اکاؤنٹ سیٹنگز میں کبھی بھی کینسل کریں۔"
          }
        }
      }
    },
    "You'll be charged %@ today. Auto-renews until cancelled — cancel anytime in your Apple Account settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم خصم %@ منك اليوم. يتجدد تلقائياً حتى الإلغاء — ألغِ في أي وقت من إعدادات Apple Account."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ আপনার কাছ থেকে %@ চার্জ হবে। বাতিল না করা পর্যন্ত অটো-রিনিউ হবে — Apple Account সেটিংসে গিয়ে যেকোনো সময় বাতিল করা যাবে।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir werden heute %@ berechnet. Verlängert sich automatisch bis zur Kündigung — jederzeit in deinen Apple-Account-Einstellungen kündbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be charged %@ today. Auto-renews until cancelled — cancel anytime in your Apple Account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te cobrará %@ hoy. Se renueva automáticamente hasta que canceles — cancela cuando quieras en los ajustes de tu Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras facturé %@ aujourd'hui. Renouvellement automatique jusqu'à annulation — annule à tout moment dans les réglages de ton Apple Account."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपसे %@ लिया जाएगा। रद्द करने तक अपने-आप रिन्यू होता है — अपनी Apple Account सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu akan ditagih %@ hari ini. Diperpanjang otomatis sampai dibatalkan — batalkan kapan saja di pengaturan Apple Account-mu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日%@が請求されます。キャンセルするまで自動更新されます。Apple Accountの設定でいつでもキャンセルできます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आज तपाईंलाई %@ चार्ज गरिनेछ। रद्द नगरेसम्म आफैँ नवीकरण हुन्छ — Apple खाताको सेटिङबाट जहिले पनि रद्द गर्न सकिन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você será cobrado %@ hoje. Renova automaticamente até o cancelamento — cancele quando quiser nas configurações da sua Apple Account."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج آپ سے %@ چارج کیا جائے گا۔ کینسل ہونے تک خودکار تجدید ہوتی رہے گی — Apple اکاؤنٹ سیٹنگز میں کبھی بھی کینسل کریں۔"
          }
        }
      }
    },
    "You'll receive a confirmation email at your new address.": {
      "localizations": {
        "ar": {
          "stringUnit": {
