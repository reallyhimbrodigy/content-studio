    "This stops the edit before it starts — your daily render won't be used.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يوقف التعديل قبل أن يبدأ — ولن تُحتسب معالجتك اليومية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে এডিট শুরুর আগেই থেমে যাবে — আপনার দৈনিক রেন্ডার খরচ হবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das stoppt den Schnitt, bevor er beginnt — dein Tages-Render wird nicht verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detiene el montaje antes de empezar — no se usará tu render diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrête le montage avant qu'il ne commence — votre rendu du jour ne sera pas utilisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे एडिट शुरू होने से पहले ही रुक जाएगा — आपका आज का रेंडर खर्च नहीं होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghentikan editan sebelum dimulai — render harian Anda tidak terpakai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集が始まる前に止まります。今日のレンダリングは消費されません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसले सम्पादन सुरु हुनुअघि नै रोक्छ — तपाईंको दैनिक रेन्डर खर्च हुँदैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso interrompe a edição antes de começar — seu render do dia não será usado."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے ایڈٹ شروع ہونے سے پہلے ہی رک جائے گا — آپ کا آج کا رینڈر خرچ نہیں ہوگا۔"
          }
        }
      }
    },
    "This version has a problem we've fixed. Grab the update and you're back in seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا الإصدار مشكلة أصلحناها. حمّل التحديث وستعود خلال ثوانٍ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সংস্করণে একটা সমস্যা ছিল, আমরা ঠিক করে দিয়েছি। আপডেট নিন, কয়েক সেকেন্ডেই ফিরে আসবেন।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version hat ein Problem, das wir behoben haben. Hol dir das Update und du bist in Sekunden zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión tiene un problema que ya hemos corregido. Instala la actualización y vuelves en segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version a un problème que nous avons corrigé. Installez la mise à jour et vous repartez en quelques secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्शन में एक दिक्कत थी, जो हमने ठीक कर दी है। अपडेट लें और कुछ ही सेकंड में वापस आ जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi ini punya masalah yang sudah kami perbaiki. Ambil pembaruannya dan Anda kembali dalam hitungan detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンには不具合があり、すでに修正済みです。アップデートすれば数秒で戻れます。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो संस्करणमा एउटा समस्या थियो, हामीले ठीक गरिसक्यौं। अपडेट लिनुहोस्, केही सेकेन्डमै फर्किनुहुन्छ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão tem um problema que já corrigimos. Baixe a atualização e você volta em segundos."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ورژن میں ایک مسئلہ تھا جو ہم نے ٹھیک کر دیا ہے۔ اپ ڈیٹ لیں اور چند سیکنڈ میں واپس آ جائیں۔"
          }
        }
      }
    },
    "This will permanently delete your account and all your data. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف حسابك وكل بياناتك نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে আপনার অ্যাকাউন্ট ও সব ডেটা স্থায়ীভাবে মুছে যাবে। এটি আর ফেরানো যাবে না।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto und alle deine Daten werden dauerhaft gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borrará permanentemente tu cuenta y todos tus datos. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte et toutes vos données seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपका खाता और आपका सारा डेटा हमेशा के लिए मिट जाएगा। इसे वापस नहीं लाया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus akun dan semua data Anda secara permanen. Tindakan ini tidak bisa dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとすべてのデータが完全に削除されます。元に戻すことはできません。"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यसले तपाईंको खाता र सबै डेटा स्थायी रूपमा मेटाउँछ। यो फिर्ता ल्याउन सकिँदैन।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso vai apagar permanentemente sua conta e todos os seus dados. Não dá para desfazer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے آپ کا اکاؤنٹ اور تمام ڈیٹا مستقل طور پر حذف ہو جائے گا۔ اسے واپس نہیں لایا جا سکتا۔"
          }
        }
      }
    },
