            "value": "आपने जो कुछ बनाया वह अब भी यहाँ है। जहाँ छोड़ा था वहीं से शुरू करें।"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما أنشأته لا يزال هنا. أكمل من حيث توقفت."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang kamu buat masih ada. Lanjutkan dari tempat kamu berhenti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez créé est toujours là. Reprenez où vous vous êtes arrêté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du erstellt hast, ist noch da. Mach da weiter, wo du aufgehört hast."
          }
        },
