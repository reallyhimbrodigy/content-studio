<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.usepromptly.ios</string>
			</array>
			<key>CFBundleURLName</key>
			<string>app.usepromptly.ios</string>
		</dict>
		<!--
			TikTok Open SDK callback URL types. The SDK requires TWO schemes:
			tiktokopensdk{ClientKey} — OAuth callback
			tiktoksharesdk{ClientKey} — share result callback
			Fill in TikTokClientKey below after registering at
			https://developers.tiktok.com/ then replace the placeholder strings.
		-->
		<dict>
			<key>CFBundleURLName</key>
			<string>tiktok-opensdk</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tiktokopensdkREPLACE_WITH_CLIENT_KEY</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>tiktok-sharesdk</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tiktoksharesdkREPLACE_WITH_CLIENT_KEY</string>
			</array>
		</dict>
	</array>
	<!--
		Schemes this app needs to canOpenURL against. Without these,
		UIApplication.canOpenURL returns false for the target app and the
		export buttons would silently degrade.
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tiktokopensdk</string>
		<string>tiktoksharesdk</string>
		<string>snssdk1233</string>
		<string>instagram</string>
		<string>instagram-stories</string>
	</array>
	<!--
		TikTok Open SDK client key — register at https://developers.tiktok.com/
		Leave empty to disable SDK-based sharing (falls back to opening TikTok
		app via URL scheme, which works but skips the direct-to-composer flow).
	-->
	<key>TikTokClientKey</key>
	<string></string>
	<!--
		Facebook App ID — register at https://developers.facebook.com/
		Required only for Instagram Stories pasteboard sharing. Leave empty to
		disable Stories share (Feed/Reel share still works via URL scheme).
	-->
	<key>FacebookAppID</key>
	<string></string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Promptly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Promptly needs camera access to record videos for editing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Promptly needs photo library access to select videos for editing.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Promptly needs permission to save edited videos to your photo library.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
