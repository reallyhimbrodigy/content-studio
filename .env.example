# Optional canonical host enforcement
CANONICAL_HOST=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Provide either STRIPE_PRICE_ID or STRIPE_PRICE_LOOKUP_KEY
STRIPE_PRICE_ID=
STRIPE_PRICE_LOOKUP_KEY=promptly_pro_monthly

# Public base URL for building Stripe success/cancel URLs
# Example: https://usepromptly.app
PUBLIC_BASE_URL=

# RevenueCat (iOS subscriptions)
# REVENUECAT_WEBHOOK_AUTH — shared secret. Must EXACTLY match the
#   "Authorization: Bearer <value>" header set in RevenueCat dashboard →
#   Project → Webhooks. If unset, /api/revenuecat/webhook returns 503 and
#   NO purchase ever activates Pro server-side.
REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_SECRET_KEY — RevenueCat REST *v2* API key (Project → API keys →
#   "V2" secret key, starts with sk_). Powers POST /api/revenuecat/sync
#   (synchronous activation right after purchase) and the webhook's TRANSFER
#   reconciliation. If unset, the app silently falls back to webhook-only
#   activation (no regression).
REVENUECAT_SECRET_KEY=
# REVENUECAT_PROJECT_ID — the v2 API is project-scoped, so this is required
#   alongside REVENUECAT_SECRET_KEY. Find it in the RevenueCat dashboard URL
#   (app.revenuecat.com/projects/<THIS>/...) or Project settings; format proj….
REVENUECAT_PROJECT_ID=
