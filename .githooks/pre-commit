#!/usr/bin/env bash
# PRE-COMMIT GATE — the fulfilment lane's checks, by EXIT CODE.
#
# WHY THIS EXISTS (2026-09-19): __smoke_density_is_not_a_gate.js was written to
# stop the density rates from becoming a threshold, and then a commit went in
# with that very gate FAILING. I read its output, saw two new legs pass, and
# never read the verdict line. A check whose result is a PRINTOUT is a check
# somebody reads when they remember to; a check whose result is an EXIT CODE is
# machinery. Same doctrine as the pre-push quiet window, applied one layer down.
#
# Emergency override, loud and never default:
#     PROMPTLY_SKIP_LANE_GATES=1 git commit ...
# It prints what it skipped. Use it to land a fix for a gate that is itself
# broken, never to land work the gate refuses.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

# ---- ONE OWNER PER CHECKOUT ------------------------------------------------
# 2026-09-21: content-studio-87 needed a branch and, instead of `git worktree
# add`, created lane/reedit-versions and checked it out INSIDE content-studio-44's
# checkout. That silently moved 44's tree off release/256 — the branch build 256
# had just been archived and submitted from. Nothing was lost, because 44 happened
# to have a clean tree at that moment. Mid-edit it would have been.
#
# 87 broke no enforced rule. "Every agent works in its own worktree" was written
# in THREE documents (CHECKOUTS.md, DEPLOY_LOG.md, LANE_OWNERSHIP.md) and enforced
# by none. That is what failed, not a missing hook in one repo.
#
# An UNCLAIMED tree (no .lane-owner) commits freely, so this cannot brick an
# existing checkout the day it lands. Enforcement is strict once claimed — and the
# tree that got walked into was a claimed one, so the real case is still caught.
#
# DELIBERATELY ABOVE the PROMPTLY_SKIP_LANE_GATES override below. That flag exists
# to land a fix for a gate that is itself broken; it is not a licence to commit in
# somebody else's checkout, and those are different questions.
__lane_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "${__lane_root:-}" ] && [ -f "$__lane_root/.lane-owner" ]; then
  __owner="$(tr -d ' \t\r\n' < "$__lane_root/.lane-owner")"
  if [ -n "$__owner" ]; then
    __me="${LANE_OWNER:-}"
    if [ -z "$__me" ]; then
      echo "pre-commit: REFUSED — this checkout belongs to '$__owner' and you have not said who you are." >&2
      echo "   $__lane_root" >&2
      echo "   Set LANE_OWNER, or make your own:  git worktree add ../content-studio-<you> -b <branch>" >&2
      exit 1
    fi
    if [ "$__me" != "$__owner" ]; then
      echo "pre-commit: REFUSED — wrong checkout." >&2
      echo "   this tree is owned by : $__owner" >&2
      echo "   you are               : $__me" >&2
      echo "   $__lane_root" >&2
      echo "   Committing here puts your work on someone else's branch, and checking out" >&2
      echo "   your own moves their tree under them mid-edit. Make your own instead:" >&2
      echo "     git worktree add ../content-studio-$__me -b <branch>" >&2
      exit 1
    fi
  fi
fi
# ---- end one owner per checkout --------------------------------------------

if [ "${PROMPTLY_SKIP_LANE_GATES:-}" = "1" ]; then
  echo "pre-commit: SKIPPED by PROMPTLY_SKIP_LANE_GATES=1 — the lane gates did not run" >&2
  exit 0
fi

# Each is run bare and its status read directly. No pipes: `cmd | tail` reports
# TAIL's status, which is how two wrong PASS readings got reported in this lane.
GATES=(
  "lib/__smoke_density_is_not_a_gate.js"
  "lib/__smoke_negotiation_classifier.js"
  "lib/__smoke_negotiation_wiring.js"
  "scripts/fulfilment/smoke_scoreboard_line.js"
  "scripts/fulfilment/smoke_retry_law.js"
)
fail=0
for g in "${GATES[@]}"; do
  [ -f "$g" ] || continue          # a gate not present in this tree is not a pass
  out=$(node "$g" 2>&1); rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "pre-commit: BLOCKED by $g (exit $rc)" >&2
    echo "$out" | tail -8 >&2
    fail=1
  fi
done
[ "$fail" -eq 0 ] || { echo "pre-commit: commit refused. Fix the gate or explain the override." >&2; exit 1; }
exit 0
